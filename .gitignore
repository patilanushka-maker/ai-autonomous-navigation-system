# Byte-compiled / optimized / Python cache files
__pycache__/
*.py[cod]
*$py.class

# Distribution and packaging artifacts
build/
dist/
*.egg-info/
.eggs/

# Virtual Environments
.venv/
venv/
env/
ENV/

# Secrets and Environment Variables (Strictly excluded from version control)
.env
*.env
.env.*
!.env.example
.streamlit/secrets.toml

# Testing and coverage artifacts
.pytest_cache/
.coverage
htmlcov/
.tox/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# IDE and Editor configurations
.idea/
.vscode/
*.swp
*.swo
.cursor/
.antigravity/
.gemini/

# OS-generated files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Temporary logs and runtime output files
*.log
outputs/figures/*
outputs/logs/*
outputs/metrics/*
!outputs/figures/.gitkeep
!outputs/logs/.gitkeep
!outputs/metrics/.gitkeep

# GitHub workflows (requires workflow scope if tracked)
.github/
