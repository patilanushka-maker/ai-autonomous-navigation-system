# Environment Configuration Template
# Copy this file to .env and adjust local variables as needed.
# Note: The actual .env file is excluded from git commits by .gitignore.

# Streamlit Server Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ADDRESS=localhost

# Simulation Logging and Output Controls
SIMULATION_LOG_LEVEL=INFO
SIMULATION_MAX_STEPS=2000
SIMULATION_RANDOM_SEED=42
